<?xml version="1.0" encoding="utf-8"?>
<!--
   Cloud backup / device transfer rules (API 31+).
   Exclude Aletheia offline outbox + billing/consent prefs (purchase tokens).
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="aletheia_outbox.xml" />
        <exclude domain="sharedpref" path="aletheia_beta_prefs.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="aletheia_outbox.xml" />
        <exclude domain="sharedpref" path="aletheia_beta_prefs.xml" />
    </device-transfer>
</data-extraction-rules>
