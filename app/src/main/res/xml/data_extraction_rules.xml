<?xml version="1.0" encoding="utf-8"?>
<!--
   Cloud backup / device transfer rules (API 31+).
   Exclude Aletheia offline outbox chat content.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="aletheia_outbox.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="aletheia_outbox.xml" />
    </device-transfer>
</data-extraction-rules>
