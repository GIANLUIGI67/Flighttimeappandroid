<?xml version="1.0" encoding="utf-8"?><!--
   Sample data extraction rules file; uncomment and customize as necessary.
   See https://developer.android.com/about/versions/12/backup-restore#xml-changes
   for details.
-->
<data-extraction-rules>
    <cloud-backup>
        <!-- Preserve Salary history while excluding device/auth identity by
             allowing only the dedicated Salary SharedPreferences file. -->
        <include domain="sharedpref" path="salary_storage.xml" />
    </cloud-backup>
    <device-transfer>
        <include domain="sharedpref" path="salary_storage.xml" />
    </device-transfer>
</data-extraction-rules>
