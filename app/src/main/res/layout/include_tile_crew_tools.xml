<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="6dp">
    <ImageView
        android:layout_width="34dp"
        android:layout_height="34dp"
        android:contentDescription="@string/crew_tools"
        android:src="@drawable/ic_crew_tools"
        app:tint="@color/homeOrange" />
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:ellipsize="end"
        android:gravity="center"
        android:maxLines="1"
        android:text="@string/crew_tools"
        android:textColor="@color/homeNavy"
        android:textSize="13sp"
        android:textStyle="bold" />
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:background="@drawable/bg_coming_soon_badge"
        android:paddingHorizontal="8dp"
        android:paddingVertical="3dp"
        android:text="@string/coming_soon"
        android:textColor="@color/homeOrange"
        android:textSize="8sp"
        android:textStyle="bold" />
</LinearLayout>
