<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/iosBackground"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <ImageButton
            android:id="@+id/aletheiaPaywallClose"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@android:color/transparent"
            android:contentDescription="@string/aletheia_close"
            android:src="@drawable/ic_back"
            app:tint="@color/iosText" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/aletheia_brand"
            android:textColor="@color/homeNavy"
            android:textSize="26sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/aletheia_paywall_title"
            android:textColor="@color/iosText"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/aletheia_paywall_body"
            android:textColor="@color/iosHint"
            android:textSize="14sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="@string/aletheia_plans_subscriptions"
            android:textColor="@color/homeNavy"
            android:textSize="15sp"
            android:textStyle="bold" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/aletheiaBuyPlus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/aletheia_plan_plus"
            android:textAllCaps="false" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/aletheiaBuyPro"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/aletheia_plan_pro"
            android:textAllCaps="false" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/aletheiaBuyMax"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/aletheia_plan_max"
            android:textAllCaps="false" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="@string/aletheia_plans_credits"
            android:textColor="@color/homeNavy"
            android:textSize="15sp"
            android:textStyle="bold" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/aletheiaBuyCreditsS"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/aletheia_credits_s"
            android:textAllCaps="false" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/aletheiaBuyCreditsM"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/aletheia_credits_m"
            android:textAllCaps="false" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/aletheiaBuyCreditsL"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/aletheia_credits_l"
            android:textAllCaps="false" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/aletheia_paywall_wait"
            android:textColor="@color/iosHint"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/aletheiaPaywallStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:textColor="@color/iosHint"
            android:textSize="12sp" />
    </LinearLayout>
</ScrollView>
