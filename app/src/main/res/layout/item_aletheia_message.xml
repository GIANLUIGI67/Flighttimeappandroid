<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingVertical="6dp">

    <TextView
        android:id="@+id/aletheiaSourceBadge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_aletheia_badge"
        android:paddingHorizontal="8dp"
        android:paddingVertical="2dp"
        android:textColor="@color/homeNavy"
        android:textSize="11sp"
        android:textStyle="bold"
        android:visibility="gone" />

    <TextView
        android:id="@+id/aletheiaMessageText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:lineSpacingExtra="2dp"
        android:textColor="@color/iosText"
        android:textSize="15sp" />

    <LinearLayout
        android:id="@+id/aletheiaFeedbackRow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:visibility="gone">

        <ImageButton
            android:id="@+id/aletheiaFbGood"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="@android:color/transparent"
            android:contentDescription="@string/aletheia_feedback_good"
            android:src="@drawable/ic_aletheia_thumb_up" />

        <ImageButton
            android:id="@+id/aletheiaFbPartial"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_marginStart="4dp"
            android:background="@android:color/transparent"
            android:contentDescription="@string/aletheia_feedback_partial"
            android:src="@drawable/ic_aletheia_neutral" />

        <ImageButton
            android:id="@+id/aletheiaFbBad"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_marginStart="4dp"
            android:background="@android:color/transparent"
            android:contentDescription="@string/aletheia_feedback_bad"
            android:src="@drawable/ic_aletheia_thumb_down" />
    </LinearLayout>

    <TextView
        android:id="@+id/aletheiaFeedbackContinueHint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:lineSpacingExtra="2dp"
        android:text="@string/aletheia_feedback_continue_hint"
        android:textColor="@color/iosHint"
        android:textSize="12sp"
        android:visibility="gone" />
</LinearLayout>
