<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/iosBackground"
    android:clipToPadding="false"
    android:paddingBottom="28dp">

    <FrameLayout
        android:id="@+id/homeHero"
        android:layout_width="match_parent"
        android:layout_height="250dp"
            android:background="@drawable/bg_home_hero"
            app:layout_constraintTop_toTopOf="parent">

            <ImageView
                android:id="@+id/heroPhoto"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="@string/app_name"
                android:scaleType="centerCrop"
                android:src="@drawable/home_hero_sunset" />

            <View
                android:id="@+id/heroScrim"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/bg_home_hero_scrim" />

            <ImageView
                android:id="@+id/heroSwoosh"
                android:layout_width="match_parent"
                android:layout_height="180dp"
                android:layout_gravity="bottom"
                android:layout_marginBottom="2dp"
                android:alpha="0.96"
                android:contentDescription="@string/app_name"
                android:scaleType="fitXY"
                android:src="@drawable/ic_home_swoosh" />

            <ImageView
                android:id="@+id/heroPlane"
                android:layout_width="74dp"
                android:layout_height="74dp"
                android:layout_gravity="top|end"
                android:layout_marginTop="88dp"
                android:layout_marginEnd="18dp"
                android:contentDescription="@string/app_name"
                android:rotation="49"
                android:src="@drawable/ic_plane_badge" />

            <TextView
                android:id="@+id/heroTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom"
                android:layout_marginStart="32dp"
                android:layout_marginEnd="102dp"
                android:layout_marginBottom="82dp"
                android:ellipsize="end"
                android:includeFontPadding="false"
                android:singleLine="true"
                android:text="@string/app_name"
                android:textColor="@android:color/white"
                android:textSize="35sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/heroSubtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom"
                android:layout_marginStart="32dp"
                android:layout_marginEnd="96dp"
                android:layout_marginBottom="52dp"
                android:ellipsize="end"
                android:singleLine="true"
                android:text="@string/home_companion"
                android:textColor="#D6FFFFFF"
                android:textSize="18sp"
                android:textStyle="bold" />

            <View
                android:id="@+id/heroBottomCurve"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_gravity="bottom"
                android:layout_marginHorizontal="-10dp"
                android:background="@drawable/bg_home_bottom_curve" />
        </FrameLayout>

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardCalculator"
            android:layout_width="0dp"
            android:layout_height="104dp"
            android:layout_marginHorizontal="18dp"
            android:layout_marginTop="-42dp"
            android:clickable="true"
            android:focusable="true"
            app:cardBackgroundColor="@android:color/white"
            app:cardCornerRadius="26dp"
            app:cardElevation="8dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/homeHero"
            app:strokeColor="@color/homeCardStroke"
            app:strokeWidth="1dp">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:paddingHorizontal="18dp">

                <ImageView
                    android:id="@+id/calculatorIcon"
                    android:layout_width="62dp"
                    android:layout_height="62dp"
                    android:contentDescription="@string/flight_time_calculator"
                    android:src="@drawable/ic_calculator_clock"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <TextView
                    android:id="@+id/calculatorTitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:layout_marginEnd="10dp"
                    android:ellipsize="end"
                    android:includeFontPadding="false"
                    android:text="@string/flight_time_line_1"
                    android:textColor="@color/homeNavy"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    app:layout_constraintBottom_toTopOf="@id/calculatorSubtitle"
                    app:layout_constraintEnd_toStartOf="@id/startButtonLabel"
                    app:layout_constraintStart_toEndOf="@id/calculatorIcon"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintVertical_chainStyle="packed" />

                <TextView
                    android:id="@+id/calculatorSubtitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:layout_marginEnd="10dp"
                    android:ellipsize="end"
                    android:includeFontPadding="false"
                    android:text="@string/calculator_line_2"
                    android:textColor="@color/homeNavy"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toStartOf="@id/startButtonLabel"
                    app:layout_constraintStart_toEndOf="@id/calculatorIcon"
                    app:layout_constraintTop_toBottomOf="@id/calculatorTitle" />

                <ImageView
                    android:id="@+id/calculatorChevron"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:contentDescription="@string/cd_chevron"
                    android:src="@drawable/ic_chevron_right"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:tint="@color/homeNavy" />

                <TextView
                    android:id="@+id/startButtonLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="44dp"
                    android:background="@drawable/bg_home_start"
                    android:gravity="center"
                    android:minWidth="84dp"
                    android:paddingHorizontal="16dp"
                    android:text="@string/start"
                    android:textColor="@android:color/white"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />
            </androidx.constraintlayout.widget.ConstraintLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardSalary"
            style="@style/HomeTile"
            android:layout_marginStart="24dp"
            android:layout_marginTop="10dp"
            app:layout_constraintEnd_toStartOf="@id/cardLayover"
            app:layout_constraintHorizontal_chainStyle="spread"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/cardCalculator">
            <include layout="@layout/include_tile_salary" />
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardLayover"
            style="@style/HomeTile"
            android:layout_marginHorizontal="12dp"
            app:layout_constraintEnd_toStartOf="@id/cardTraining"
            app:layout_constraintStart_toEndOf="@id/cardSalary"
            app:layout_constraintTop_toTopOf="@id/cardSalary">
            <include layout="@layout/include_tile_layover" />
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardTraining"
            style="@style/HomeTile"
            android:layout_marginEnd="24dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@id/cardLayover"
            app:layout_constraintTop_toTopOf="@id/cardSalary">
            <include layout="@layout/include_tile_training" />
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardCrewJobs"
            style="@style/HomeTile"
            android:layout_marginStart="24dp"
            android:layout_marginTop="8dp"
            app:layout_constraintEnd_toStartOf="@id/cardCrewTools"
            app:layout_constraintHorizontal_chainStyle="spread"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/cardSalary">
            <include layout="@layout/include_tile_crew_jobs" />
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardCrewTools"
            style="@style/HomeTile"
            android:layout_marginHorizontal="12dp"
            app:layout_constraintEnd_toStartOf="@id/cardCrewForum"
            app:layout_constraintStart_toEndOf="@id/cardCrewJobs"
            app:layout_constraintTop_toTopOf="@id/cardCrewJobs">
            <include layout="@layout/include_tile_crew_tools" />
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardCrewForum"
            style="@style/HomeTile"
            android:layout_marginEnd="24dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@id/cardCrewTools"
            app:layout_constraintTop_toTopOf="@id/cardCrewJobs">
            <include layout="@layout/include_tile_crew_forum" />
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/contactBtn"
            style="@style/HomeTile"
            android:layout_marginStart="24dp"
            android:layout_marginTop="8dp"
            app:layout_constraintEnd_toStartOf="@id/shareBtnCard"
            app:layout_constraintHorizontal_chainStyle="spread"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/cardCrewJobs">
            <include layout="@layout/include_tile_contact" />
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/shareBtnCard"
            style="@style/HomeTile"
            android:layout_marginHorizontal="12dp"
            app:layout_constraintEnd_toStartOf="@id/cardPro"
            app:layout_constraintStart_toEndOf="@id/contactBtn"
            app:layout_constraintTop_toTopOf="@id/contactBtn">
            <include layout="@layout/include_tile_share" />
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardPro"
            style="@style/HomeTile"
            android:layout_marginEnd="24dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@id/shareBtnCard"
            app:layout_constraintTop_toTopOf="@id/contactBtn">
            <include layout="@layout/include_tile_pro" />
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/crewReadyCard"
            android:layout_width="0dp"
            android:layout_height="84dp"
            android:layout_marginHorizontal="18dp"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="18dp"
            app:cardBackgroundColor="@android:color/white"
            app:cardCornerRadius="24dp"
            app:cardElevation="6dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/contactBtn"
            app:layout_constraintVertical_bias="1"
            app:strokeColor="@color/homeCardStroke"
            app:strokeWidth="1dp">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:paddingHorizontal="20dp">

                <FrameLayout
                    android:id="@+id/crewIconCircle"
                    android:layout_width="52dp"
                    android:layout_height="52dp"
                    android:background="@drawable/bg_home_orange_circle"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent">
                    <ImageView
                        android:layout_width="30dp"
                        android:layout_height="30dp"
                        android:layout_gravity="center"
                        android:contentDescription="@string/crew_ready"
                        android:src="@drawable/ic_people"
                        app:tint="@android:color/white" />
                </FrameLayout>

                <TextView
                    android:id="@+id/crewReadyTitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="18dp"
                    android:layout_marginEnd="10dp"
                    android:ellipsize="end"
                    android:singleLine="true"
                    android:text="@string/crew_ready"
                    android:textColor="@color/homeNavy"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    app:layout_constraintBottom_toTopOf="@id/crewReadyMessage"
                    app:layout_constraintEnd_toStartOf="@id/crewWindow"
                    app:layout_constraintStart_toEndOf="@id/crewIconCircle"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintVertical_chainStyle="packed" />

                <View
                    android:id="@+id/crewReadyDot"
                    android:layout_width="9dp"
                    android:layout_height="9dp"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/unread_dot_green"
                    app:layout_constraintBottom_toBottomOf="@id/crewReadyTitle"
                    app:layout_constraintStart_toEndOf="@id/crewReadyTitle"
                    app:layout_constraintTop_toTopOf="@id/crewReadyTitle" />

                <TextView
                    android:id="@+id/crewReadyMessage"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="18dp"
                    android:layout_marginEnd="10dp"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="@string/crew_ready_message"
                    android:textColor="@color/iosHint"
                    android:textSize="12sp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toStartOf="@id/crewWindow"
                    app:layout_constraintStart_toEndOf="@id/crewIconCircle"
                    app:layout_constraintTop_toBottomOf="@id/crewReadyTitle" />

                <FrameLayout
                    android:id="@+id/crewWindow"
                    android:layout_width="68dp"
                    android:layout_height="56dp"
                    android:background="@drawable/bg_home_window"
                    android:clipToOutline="true"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent">
                    <ImageView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:contentDescription="@string/app_name"
                        android:scaleType="centerCrop"
                        android:src="@drawable/home_hero_sunset" />
                    <View
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="#33031B3D" />
                    <ImageView
                        android:layout_width="74dp"
                        android:layout_height="50dp"
                        android:layout_gravity="bottom|start"
                        android:layout_marginStart="-4dp"
                        android:layout_marginBottom="3dp"
                        android:contentDescription="@string/app_name"
                        android:scaleType="fitXY"
                        android:src="@drawable/ic_home_mini_swoosh" />
                    <ImageView
                        android:layout_width="42dp"
                        android:layout_height="42dp"
                        android:layout_gravity="center_vertical|end"
                        android:layout_marginEnd="7dp"
                        android:contentDescription="@string/app_name"
                        android:rotation="49"
                        android:src="@drawable/ic_plane_badge" />
                </FrameLayout>
            </androidx.constraintlayout.widget.ConstraintLayout>
        </com.google.android.material.card.MaterialCardView>

</androidx.constraintlayout.widget.ConstraintLayout>
