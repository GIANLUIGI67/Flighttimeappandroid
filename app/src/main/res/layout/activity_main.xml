<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/iosBackground"
    android:clipToPadding="false"
    android:fillViewport="true">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingBottom="42dp">

        <FrameLayout
            android:id="@+id/homeHero"
            android:layout_width="match_parent"
            android:layout_height="322dp"
            android:background="@drawable/bg_home_hero"
            app:layout_constraintTop_toTopOf="parent">

            <ImageView
                android:id="@+id/heroPhoto"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="@string/app_name"
                android:scaleType="centerCrop"
                android:src="@drawable/home_hero_sunset" />

            <View
                android:id="@+id/heroScrim"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/bg_home_hero_scrim" />

            <ImageView
                android:id="@+id/heroSwoosh"
                android:layout_width="match_parent"
                android:layout_height="220dp"
                android:layout_gravity="bottom"
                android:layout_marginBottom="6dp"
                android:alpha="0.96"
                android:contentDescription="@string/app_name"
                android:scaleType="fitXY"
                android:src="@drawable/ic_home_swoosh" />

            <ImageView
                android:id="@+id/heroPlane"
                android:layout_width="84dp"
                android:layout_height="84dp"
                android:layout_gravity="top|end"
                android:layout_marginTop="110dp"
                android:layout_marginEnd="46dp"
                android:contentDescription="@string/app_name"
                android:rotation="-22"
                android:src="@drawable/ic_airplane" />

            <TextView
                android:id="@+id/heroTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom"
                android:layout_marginStart="32dp"
                android:layout_marginEnd="32dp"
                android:layout_marginBottom="96dp"
                android:ellipsize="end"
                android:includeFontPadding="false"
                android:singleLine="true"
                android:text="@string/app_name"
                android:textColor="@android:color/white"
                android:textSize="38sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/heroSubtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom"
                android:layout_marginStart="32dp"
                android:layout_marginEnd="32dp"
                android:layout_marginBottom="64dp"
                android:ellipsize="end"
                android:singleLine="true"
                android:text="@string/home_companion"
                android:textColor="#D6FFFFFF"
                android:textSize="20sp"
                android:textStyle="bold" />

            <View
                android:id="@+id/heroBottomCurve"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_gravity="bottom"
                android:layout_marginHorizontal="-10dp"
                android:background="@drawable/bg_home_bottom_curve" />
        </FrameLayout>

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardCalculator"
            android:layout_width="0dp"
            android:layout_height="118dp"
            android:layout_marginHorizontal="18dp"
            android:layout_marginTop="-36dp"
            android:clickable="true"
            android:focusable="true"
            app:cardBackgroundColor="@android:color/white"
            app:cardCornerRadius="26dp"
            app:cardElevation="8dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/homeHero"
            app:strokeColor="@color/homeCardStroke"
            app:strokeWidth="1dp">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:paddingHorizontal="18dp">

                <ImageView
                    android:id="@+id/calculatorIcon"
                    android:layout_width="70dp"
                    android:layout_height="70dp"
                    android:contentDescription="@string/flight_time_calculator"
                    android:src="@drawable/ic_calculator_clock"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <TextView
                    android:id="@+id/calculatorTitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:layout_marginEnd="10dp"
                    android:ellipsize="end"
                    android:includeFontPadding="false"
                    android:text="@string/flight_time_line_1"
                    android:textColor="@color/homeNavy"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    app:layout_constraintBottom_toTopOf="@id/calculatorSubtitle"
                    app:layout_constraintEnd_toStartOf="@id/startButtonLabel"
                    app:layout_constraintStart_toEndOf="@id/calculatorIcon"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintVertical_chainStyle="packed" />

                <TextView
                    android:id="@+id/calculatorSubtitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:layout_marginEnd="10dp"
                    android:ellipsize="end"
                    android:includeFontPadding="false"
                    android:text="@string/calculator_line_2"
                    android:textColor="@color/homeNavy"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toStartOf="@id/startButtonLabel"
                    app:layout_constraintStart_toEndOf="@id/calculatorIcon"
                    app:layout_constraintTop_toBottomOf="@id/calculatorTitle" />

                <ImageView
                    android:id="@+id/calculatorChevron"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:contentDescription="@string/cd_chevron"
                    android:src="@drawable/ic_chevron_right"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:tint="@color/homeNavy" />

                <TextView
                    android:id="@+id/startButtonLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    android:background="@drawable/bg_home_start"
                    android:gravity="center"
                    android:minWidth="84dp"
                    android:paddingHorizontal="16dp"
                    android:text="@string/start"
                    android:textColor="@android:color/white"
                    android:textSize="17sp"
                    android:textStyle="bold"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />
            </androidx.constraintlayout.widget.ConstraintLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardSalary"
            style="@style/HomeTile"
            android:layout_marginStart="24dp"
            android:layout_marginTop="20dp"
            app:layout_constraintEnd_toStartOf="@id/cardLayover"
            app:layout_constraintHorizontal_chainStyle="spread"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/cardCalculator">
            <include layout="@layout/include_tile_salary" />
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardLayover"
            style="@style/HomeTile"
            android:layout_marginHorizontal="12dp"
            app:layout_constraintEnd_toStartOf="@id/cardTraining"
            app:layout_constraintStart_toEndOf="@id/cardSalary"
            app:layout_constraintTop_toTopOf="@id/cardSalary">
            <include layout="@layout/include_tile_layover" />
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardTraining"
            style="@style/HomeTile"
            android:layout_marginEnd="24dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@id/cardLayover"
            app:layout_constraintTop_toTopOf="@id/cardSalary">
            <include layout="@layout/include_tile_training" />
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/contactBtn"
            style="@style/HomeTile"
            android:layout_marginStart="24dp"
            android:layout_marginTop="14dp"
            app:layout_constraintEnd_toStartOf="@id/shareBtnCard"
            app:layout_constraintHorizontal_chainStyle="spread"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/cardSalary">
            <include layout="@layout/include_tile_contact" />
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/shareBtnCard"
            style="@style/HomeTile"
            android:layout_marginHorizontal="12dp"
            app:layout_constraintEnd_toStartOf="@id/cardPro"
            app:layout_constraintStart_toEndOf="@id/contactBtn"
            app:layout_constraintTop_toTopOf="@id/contactBtn">
            <include layout="@layout/include_tile_share" />
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardPro"
            style="@style/HomeTile"
            android:layout_marginEnd="24dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@id/shareBtnCard"
            app:layout_constraintTop_toTopOf="@id/contactBtn">
            <include layout="@layout/include_tile_pro" />
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/crewReadyCard"
            android:layout_width="0dp"
            android:layout_height="96dp"
            android:layout_marginHorizontal="18dp"
            android:layout_marginTop="18dp"
            app:cardBackgroundColor="@android:color/white"
            app:cardCornerRadius="24dp"
            app:cardElevation="6dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/contactBtn"
            app:strokeColor="@color/homeCardStroke"
            app:strokeWidth="1dp">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:paddingHorizontal="20dp">

                <FrameLayout
                    android:id="@+id/crewIconCircle"
                    android:layout_width="58dp"
                    android:layout_height="58dp"
                    android:background="@drawable/bg_home_orange_circle"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent">
                    <ImageView
                        android:layout_width="34dp"
                        android:layout_height="34dp"
                        android:layout_gravity="center"
                        android:contentDescription="@string/crew_ready"
                        android:src="@drawable/ic_people"
                        app:tint="@android:color/white" />
                </FrameLayout>

                <TextView
                    android:id="@+id/crewReadyTitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="18dp"
                    android:layout_marginEnd="10dp"
                    android:ellipsize="end"
                    android:singleLine="true"
                    android:text="@string/crew_ready"
                    android:textColor="@color/homeNavy"
                    android:textSize="24sp"
                    android:textStyle="bold"
                    app:layout_constraintBottom_toTopOf="@id/crewReadyMessage"
                    app:layout_constraintEnd_toStartOf="@id/crewWindow"
                    app:layout_constraintStart_toEndOf="@id/crewIconCircle"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintVertical_chainStyle="packed" />

                <View
                    android:id="@+id/crewReadyDot"
                    android:layout_width="9dp"
                    android:layout_height="9dp"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/unread_dot_green"
                    app:layout_constraintBottom_toBottomOf="@id/crewReadyTitle"
                    app:layout_constraintStart_toEndOf="@id/crewReadyTitle"
                    app:layout_constraintTop_toTopOf="@id/crewReadyTitle" />

                <TextView
                    android:id="@+id/crewReadyMessage"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="18dp"
                    android:layout_marginEnd="10dp"
                    android:ellipsize="end"
                    android:singleLine="true"
                    android:text="@string/crew_ready_message"
                    android:textColor="@color/iosHint"
                    android:textSize="15sp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toStartOf="@id/crewWindow"
                    app:layout_constraintStart_toEndOf="@id/crewIconCircle"
                    app:layout_constraintTop_toBottomOf="@id/crewReadyTitle" />

                <FrameLayout
                    android:id="@+id/crewWindow"
                    android:layout_width="72dp"
                    android:layout_height="62dp"
                    android:background="@drawable/bg_home_window"
                    android:clipToOutline="true"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent">
                    <ImageView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:contentDescription="@string/app_name"
                        android:scaleType="centerCrop"
                        android:src="@drawable/home_hero_sunset" />
                    <View
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="#33031B3D" />
                    <ImageView
                        android:layout_width="38dp"
                        android:layout_height="38dp"
                        android:layout_gravity="center"
                        android:contentDescription="@string/app_name"
                        android:rotation="-18"
                        android:src="@drawable/ic_airplane" />
                </FrameLayout>
            </androidx.constraintlayout.widget.ConstraintLayout>
        </com.google.android.material.card.MaterialCardView>

    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.core.widget.NestedScrollView>
